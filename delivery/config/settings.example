import os
from pathlib import Path

from pydantic_settings import BaseSettings, SettingsConfigDict

BASE_DIR = Path(__file__).resolve().parent.parent


class Settings(BaseSettings):
    debug: bool = False
    cache_ttl: int = 00
    secret_key: str = "your_secret_key_here"
    database_host: str = "database_host"
    database_port: int = 0000
    database_name: str = "database_name"
    database_user: str = "database_user"
    database_password: str = "database_password"
    mysql_password: str = "my_sql_password"
    rabbitmq_default_user: str = "user"
    rabbitmq_default_pass: str = "password"
    rabbitmq_host: str = "rabbitmq_host"
    redis_host: str = "redis_host"
    redis_port: int = 0000

    model_config = SettingsConfigDict(env_file=".env", env_file_encoding='utf-8')


config = Settings()

